# Audifyy Backend Environment Configuration

# App Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000

# API Keys (Required)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here  # Optional for future use

# Redis Settings (Optional - uses in-memory caching if not configured)
# REDIS_URL=redis://localhost:6379
REDIS_TTL=86400

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=3600

# Processing Limits
MAX_ARTICLE_LENGTH=50000
MAX_SUMMARY_LENGTH=2000

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://audifyy.com"]