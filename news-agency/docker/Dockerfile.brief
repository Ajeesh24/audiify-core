# Base Dockerfile for Brief Generation Engine
FROM public.ecr.aws/lambda/python:3.11

# Copy requirements and install dependencies
COPY requirements.txt ${LAMBDA_TASK_ROOT}

# Upgrade pip and install dependencies with selective binary requirements
RUN pip install --upgrade pip && \
    pip install --only-binary=tiktoken,openai,langchain-openai,pydantic,httpx -r requirements.txt

# Copy the entire news-agency code
COPY . ${LAMBDA_TASK_ROOT}

# Set the CMD to your handler
CMD ["engines.brief_engine.lambda_handler"]